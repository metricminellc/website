---
import Base from '../layouts/Base.astro';
import FlowDiagram from '../components/FlowDiagram.astro';
import HeroVisual from '../components/HeroVisual.astro';
import ProofStrip from '../components/ProofStrip.astro';
import AgentEngineDiagram from '../components/AgentEngineDiagram.astro';
import OsTabs from '../components/OsTabs.astro';
import Cube from '../components/Cube.astro';
import {
  REPO_URL,
  REPO_API,
  DOCS_URL,
  RELEASE_TAG,
  RELEASE_URL,
  LICENSE_URL,
  DOC,
  AIRBYTE_CONNECTORS_URL,
} from '../consts';

// The quickstart quotes the README's "See it run" block verbatim: the
// macOS and Linux block and, behind the OS toggle (W-17), the Windows block.
const listCategories = `uv run python -c "from metricmine.query import GoldWarehouse; print(GoldWarehouse().list_fact_categories())"`;
const quickstartUnix = [
  'git clone https://github.com/metricminellc/metricmine.git',
  'cd metricmine',
  'uv sync',
  'make demo-fetch',
  listCategories,
].join('\n');
const quickstartWindows = [
  'git clone https://github.com/metricminellc/metricmine.git',
  'cd metricmine',
  'uv sync',
  'uv run mm demo-fetch',
  listCategories,
].join('\n');
---

<Base>
  <!-- hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Contract-driven data pipeline</p>
        <h1 class="display">Agents propose.<br />Humans approve.</h1>
        <p class="lede">
          MetricMine is an open source data pipeline that ends in an answer,
          not a table. AI drafts the data contracts. A person approves every
          change before deterministic code builds the warehouse. In the demo,
          seven public sources become one governed star with every join
          measured, all on one machine. Your own sources take the same path.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href={REPO_URL}>View on GitHub</a>
          <a class="btn btn-secondary" href={DOCS_URL}>Read the docs</a>
        </div>
        <div class="chip-row">
          <a class="chip tint" href={RELEASE_URL}>{RELEASE_TAG}</a>
          <a class="chip" href={LICENSE_URL}>Apache-2.0</a>
          <a class="chip" href={REPO_URL} id="star-chip">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M12 2l2.9 6.26 6.86.6-5.2 4.55 1.55 6.72L12 16.57l-6.11 3.56 1.55-6.72-5.2-4.55 6.86-.6z"
              ></path>
            </svg>
            <span id="star-text">Star it on GitHub</span>
          </a>
        </div>
      </div>
      <div class="hero-art">
        <HeroVisual />
      </div>
    </div>
  </section>

  <!-- the flow -->
  <section class="flow-band">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The flow</p>
        <h2>From raw data to a governed answer.</h2>
        <p>
          Machines do the repeatable work. People keep the judgment. Nothing
          reaches the warehouse without an approval on record.
        </p>
      </div>
      <FlowDiagram />
      <p class="mono-note">
        Agents propose. Code executes. A human approves. The full architecture
        and its committed evidence live in{' '}
        <a href={REPO_URL}>the repository</a>.
      </p>
    </div>
  </section>

  <!-- measured -->
  <section>
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Measured, not claimed</p>
        <h2>What a test holds today.</h2>
        <p>
          Every number below links to the document or test in the repository
          that carries it. There are no performance, cost, or scale figures on
          this site by rule; the measured curves live with their environment
          in the repository.
        </p>
      </div>
      <ProofStrip />
    </div>
  </section>

  <!-- why -->
  <section class="why-band">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Why it works this way</p>
        <h2>Built on three rules.</h2>
        <p>
          Most data contracts are documentation. MetricMine makes them the
          enforced interface between a pipeline and the AI agents that use it.
          Contracts generate models. Models generate contracts. Both are
          gated. A human approves every change.
        </p>
      </div>
      <div class="cards">
        <article class="card">
          <Cube />
          <h3>Contracts before code.</h3>
          <p>
            Every dataset is shaped by a contract a person approved. Change the
            contract and the change is visible, versioned, and reversible.
            Under the hood: ODCS 3.1.0, enforced at build time and tested in
            CI.
          </p>
        </article>
        <article class="card">
          <Cube />
          <h3>Humans hold the gate.</h3>
          <p>
            AI proposes and explains. It never merges its own work. The agents
            hold no warehouse credentials and never write. A person approves
            every contract and every generated model before anything runs.
            Under the hood: two proposer agents, pull requests, an ownership
            manifest.
          </p>
        </article>
        <article class="card">
          <Cube />
          <h3>Deterministic and local.</h3>
          <p>
            The pipeline runs end to end on one machine. Same inputs, same
            outputs, every time: two machines that pull the same commit build
            the same gold. Built small by design, on standard parts. Under the
            hood: dbt Core and DuckDB.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- standard parts -->
  <section>
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Standard parts</p>
        <h2>Airbyte at the door. dbt and DuckDB in the middle. MCP at the edge.</h2>
        <p>
          Nothing in the pipeline is proprietary runtime. It is a dbt project
          with contracts enforced, fed by PyAirbyte, served over MCP, and the
          meaning lives in files a person can read.
        </p>
      </div>
      <div class="cards">
        <article class="card">
          <Cube />
          <h3>Airbyte at the door.</h3>
          <p>
            Bronze lands through PyAirbyte, and the pipeline lands whatever its
            source list names. Airbyte publishes a catalog of{' '}
            <a href={AIRBYTE_CONNECTORS_URL}>600+ connectors</a> by its own
            count; the demo exercises the file connector, seven files deep.
          </p>
          <span class="under">one connector type exercised, many files</span>
        </article>
        <article class="card">
          <Cube />
          <h3>dbt and DuckDB in the middle.</h3>
          <p>
            The transforms are dbt Core models with enforced contracts. DuckDB
            is the local warehouse, chosen so the whole thing runs on one
            machine with no account. The contracts and the compiled context are
            warehouse-agnostic files in git; dbt profiles carry the execution
            plane, and a second adapter is an experiment, not a promise.
          </p>
          <span class="under">dbt-core 1.12, dbt-duckdb 1.11, DuckDB 1.4.3</span>
        </article>
        <article class="card">
          <Cube />
          <h3>MCP at the edge.</h3>
          <p>
            A read-only MCP server serves the gold star through five tools over
            one shared query module, three layers deep. The demo guide wires it
            into Claude Desktop, and every answer can say which of its parts is
            a measurement and which is what an expert wrote.
          </p>
          <span class="under">list, schema, context, query, lookup</span>
        </article>
      </div>
    </div>
  </section>

  <!-- with claude code -->
  <section class="cc-band">
    <div class="container">
      <div class="split">
        <div>
          <p class="eyebrow">Built to work with Claude Code</p>
          <h2>It comes with its own architect. Its name is Oscar.</h2>
          <p>
            MetricMine is not an alternative to Claude Code, dbt, or Airbyte.
            It is what sits between them. Silver is where meaning is decided,
            and that is human work with Claude Code beside you. Gold is
            mechanical, and the engine does it the same way every time. The
            narrow agents and the deterministic gates exist so the decisions
            that must be certain are never left to a model's best guess.
          </p>
          <p>
            Clone the repository, open Claude Code, and ask for{' '}
            <a href={DOC.oscar}>Oscar</a>: a read-only subagent that knows the
            system from its own files. Ask how the pipeline works, where a task
            is done, what a rule or a decision means, how to keep silver clean,
            or how the proposers draft contracts, and Oscar answers with the
            file and the line. Ask for a contract review and it runs the
            checklist, prints a verdict, and stops. It never edits a file.
          </p>
        </div>
        <ul class="cubes ships">
          <li>
            <Cube size={18} />
            <p>
              <a href={DOC.claudeMd}>CLAUDE.md</a>, what Oscar reads first:
              nineteen hard rules, the architecture boundaries, and the reading
              order for every spec.
            </p>
          </li>
          <li>
            <Cube size={18} />
            <p>
              The <a href={DOC.reviewSkill}>contract-review skill</a>: the
              nine-item checklist behind every verdict Oscar gives, from the
              all-or-nothing column rule to the never-weaken gate.
            </p>
          </li>
          <li>
            <Cube size={18} />
            <p>
              The <a href={DOC.guardHook}>working-tree guard</a>: a hook that
              denies any path outside the repository before a tool runs,
              deterministically.
            </p>
          </li>
          <li>
            <Cube size={18} />
            <p>
              The <a href={DOC.claudeAction}>Claude Code Action</a>: a mention
              in an issue or a pull request runs Claude Code on a runner, and
              it commits to a branch for a person to review and merge.
            </p>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- for engineers -->
  <section class="eng-band">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">For engineers</p>
        <h2>Run it locally.</h2>
        <p>
          No cloud account, no cluster, no signup. Python 3.12 and uv, on
          macOS, Linux, or Windows x64. Two minutes to a served star; about eight
          more to rebuild everything from raw data. The step-by-step
          walkthrough is <a href={DOC.demo}>the ten-minute demo</a>.
        </p>
      </div>
      <OsTabs id="quickstart" unix={quickstartUnix} windows={quickstartWindows} />
    </div>
  </section>

  <!-- how the pieces meet -->
  <section>
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How the pieces meet</p>
        <h2>Two agents that only propose. One engine that only executes.</h2>
        <p>
          The agent layer runs along the top and ends at a person. The engine
          runs along the bottom and starts at the contract that person merged.
          Nothing crosses between them except through git.
        </p>
      </div>
      <figure class="figure">
        <div class="scroll">
          <AgentEngineDiagram />
        </div>
        <figcaption>
          Each proposer is one structured API call with no tools and no loops.
          The engine emits dbt model files, never DDL. Serving is read-only
          three layers deep. Design: <a href={DOC.agentSpec}>the agent layer spec</a>,{' '}
          <a href={DOC.engineSpec}>the engine spec</a>, and{' '}
          <a href={DOC.servingSpec}>the serving spec</a>.
        </figcaption>
      </figure>
    </div>
  </section>

  <script define:vars={{ REPO_API }}>
    // Live star count, verifiable social proof only. Fails silent. Runs
    // after the load event so the one API call never sits in the critical
    // request chain (W2 finding F-W2-5).
    const loadStars = () =>
      fetch(REPO_API)
        .then((r) => (r.ok ? r.json() : null))
        .then((data) => {
          const n = data && data.stargazers_count;
          if (typeof n === 'number') {
            document.getElementById('star-text').textContent =
              `${n} ${n === 1 ? 'star' : 'stars'} on GitHub`;
          }
        })
        .catch(() => {});
    if (document.readyState === 'complete') {
      loadStars();
    } else {
      window.addEventListener('load', loadStars, { once: true });
    }
  </script>

  <style>
    .hero {
      background: var(--mm-hero-wash);
      padding-block: 80px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: center;
      gap: 48px;
    }

    .hero-art {
      display: flex;
      justify-content: center;
    }

    @media (max-width: 900px) {
      .hero {
        padding-block: 56px;
      }

      .hero-grid {
        grid-template-columns: 1fr;
        gap: 32px;
      }

      .hero-art {
        order: -1;
        width: 100%;
        max-width: 520px;
        margin-inline: auto;
      }
    }

    .flow-band,
    .why-band,
    .eng-band {
      background: var(--mm-bg-raised);
      border-block: 1px solid var(--mm-border);
    }

    .cc-band {
      background: var(--mm-bg);
      border-top: 1px solid var(--mm-border);
    }

    .cc-band h2 {
      max-width: 22ch;
    }

    .ships {
      margin-top: 8px;
    }

    .ships li {
      padding: 12px 14px;
      background: var(--mm-card-bg);
      border: 1px solid var(--mm-border);
      border-radius: 10px;
    }

    .ships p {
      font-size: 0.9375rem;
      color: var(--mm-text-2);
    }
  </style>
</Base>
