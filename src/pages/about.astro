---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cube from '../components/Cube.astro';
import symbolLight from '../../brand/web/symbol-color.svg';
import symbolDark from '../../brand/web/symbol-dark.svg';
import portrait from '../assets/justin-goff.jpg';
import {
  DOC,
  REPO_URL,
  ORG_URL,
  CONTACT_EMAIL,
  BUILDER_NAME,
  BUILDER_URL,
  RELEASE_TAG,
  RELEASE_URL,
  CHANGELOG_URL,
  AIRBYTE_CONNECTORS_URL,
  PROVERBS_16_3_URL,
} from '../consts';
import { DECISIONS, FINDINGS, Words } from '../counts';

const title = 'About | MetricMine';
const description =
  'About MetricMine: a contract-driven data pipeline built in the open as a reference implementation, its origin, its name and mark, its decision register, how to reach the project, and why its builder made it, in his own words.';
---

<Base title={title} description={description} path="/about/">
  <PageHero eyebrow="About" title="A reference implementation, kept honest in public.">
    MetricMine is a contract-driven medallion pipeline that runs end to end
    on one machine, built in the open so that every claim it makes can be
    checked by someone who has never talked to its author.
  </PageHero>

  <section>
    <div class="container split">
      <div class="prose">
        <p class="eyebrow">The project</p>
        <h2>What it is, in one paragraph.</h2>
        <p>
          Raw data lands in bronze exactly as received. A deterministic profiler
          describes it. Machine-readable ODCS contracts, hand-written or drafted
          by two narrow AI agents, shape silver and gold behind a human approval
          gate. An auto-modeling engine emits the entire gold layer from the
          approved contracts, and a read-only MCP server serves the result with
          a context registry one join from any payload, so an assistant answers
          business questions grounded in both the data and the meaning behind
          it. The current tagged release is{' '}
          <a href={RELEASE_URL}>{RELEASE_TAG}</a>; the{' '}
          <a href={CHANGELOG_URL}>changelog</a> records what each release
          landed.
        </p>
        <p class="eyebrow">Origin</p>
        <h2>2023, then 2026 in the open.</h2>
        <p>
          MetricMine began as a private prototype in 2023. The current codebase
          was rebuilt in the open in 2026 from a written specification, with
          the clean-room rule recorded in <a href={DOC.notice}>NOTICE</a>: the
          repository was built fresh from an independent written
          specification, and no code from the 2023 prototype was read,
          imported, or adapted.
        </p>
      </div>
      <div class="prose">
        <p class="eyebrow">The name and the mark</p>
        <h2>MetricMine. One word, capital M twice.</h2>
        <div class="mark-row">
          <img class="symbol-light" src={symbolLight.src} width="72" height="72" alt="The MetricMine symbol: three connected isometric cubes" />
          <img class="symbol-dark" src={symbolDark.src} width="72" height="72" alt="" />
          <p>
            The symbol is three connected cubes. The cubes stand for data
            modeled as cubes; the connections stand for sources joined into
            one star, which is what the engine builds.
          </p>
        </div>
        <p>
          The name and the logo are not covered by the Apache-2.0 license.
          Forks and derivative works may not use them in a way that suggests
          endorsement by, or affiliation with, this project. The brand system,
          with its vector masters and the normative standard, lives in{' '}
          <a href={DOC.websiteRepo}>the website repository</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How it is kept</p>
        <h2>The register is the project's memory.</h2>
        <p>
          Every design judgment is a numbered decision in a versioned
          register, minted by its own documentation pull request before any
          implementing change lands. Every measurement that contradicted a
          plan is a numbered finding. The stable line changes only through
          that machinery.
        </p>
      </div>
      <div class="cards">
        <article class="card">
          <Cube />
          <h3>{Words(DECISIONS)} decisions.</h3>
          <p>
            D-01 through D-{DECISIONS} with their amendments, each condensed in full
            operational substance, and a crosswalk to the rule each one became
            in the coding agent's instructions.
          </p>
          <span class="under"><a href={DOC.register}>docs/decisions/decision-register.md</a></span>
        </article>
        <article class="card">
          <Cube />
          <h3>{Words(FINDINGS)} findings.</h3>
          <p>
            F-01 through F-{FINDINGS}: toolchain behavior observed live, never
            inferred, from the first scratch gate proof to the toolchain rung,
            each one with the evidence it cites.
          </p>
          <span class="under"><a href={DOC.findings}>docs/verification/gate_proof_findings.md</a></span>
        </article>
        <article class="card">
          <Cube />
          <h3>One stability rule.</h3>
          <p>
            From v1.0.0, the pipeline, the engine, the serving layer, the two
            proposers, and the gates change only through the register, and a
            clone of main at any tag gets a working demo.
          </p>
          <span class="under"><a href={DOC.claudeMd}>CLAUDE.md, rule 19</a></span>
        </article>
      </div>
    </div>
  </section>

  <section>
    <div class="container split">
      <div class="prose">
        <p class="eyebrow">Who</p>
        <h2>Built by {BUILDER_NAME}.</h2>
        <p>
          MetricMine is a personal open source project, built and maintained
          on its author's own time. The commits, the pull requests, and the
          register carry the record; the profile is{' '}
          <a href={BUILDER_URL}>{BUILDER_NAME} on GitHub</a>.
        </p>
      </div>
      <div class="prose">
        <p class="eyebrow">Contact</p>
        <h2>One address, one organization.</h2>
        <p>
          Questions, findings, and pull requests belong on{' '}
          <a href={REPO_URL}>the repository</a>. Anything else reaches the
          project at <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
          The GitHub organization is <a href={ORG_URL}>metricminellc</a>, a
          namespace and nothing more.
        </p>
      </div>
    </div>
  </section>

  <!-- The builder's own section (W-18): first person, the pattern he saw,
       why he built it, and his thanks. The one first-person surface on the
       site. The connector count is Airbyte's own figure, cited inline as on
       every other page; the builder's own figures carry no link. -->
  <section class="band">
    <div class="container">
      <div class="prose testimony">
        <div class="byline">
          <img
            class="portrait"
            src={portrait.src}
            width="96"
            height="96"
            alt="Justin Goff"
            loading="lazy"
          />
          <div>
            <p class="eyebrow">From the builder</p>
            <h2>Why I built it.</h2>
          </div>
        </div>

        <h3>The pattern</h3>
        <p>
          My 18 years of work span software development, application
          development, data intelligence, data science, machine learning, and
          AI. One thing has held since college and in every organization
          since: everyone's data is messy, and everyone's data is fragmented
          to some degree. No exceptions, whatever the company's size or
          maturity.
        </p>
        <p>
          That fragmentation is always the blocker. It blocked transactional
          applications. It blocked analytics. It blocked predictive analytics
          and machine learning. Today it blocks generative AI and agentic
          workflows. The workload changes every few years. The bottleneck
          does not.
        </p>

        <h3>The fix</h3>
        <p>
          The fix has stayed the same too. Start with governance, embed it in
          standard operating procedures, and make it easy. Easy is the part
          most organizations skip. If governance depends on how much any one
          person knows about the process, it will not hold. Automation that
          applies governance by default is what gives it a chance to stick.
          Funding to clean this up is almost never there, one more reason the
          automated path is the only realistic one.
        </p>

        <h3>2023, then a fresh start</h3>
        <p>
          By 2023 I had watched the same cycle repeat for years: fragmented
          data, a real appetite for unified analytics on top of it, and no
          clean path between the two. I developed the concept of a unified,
          automated event star and built a private prototype on my own time.
          I planned to release it and stopped short. Family time was limited,
          and there were real gaps in the solution I could not close then.
        </p>
        <p>
          Advances in AI closed that gap, specifically embedding agents into
          the workflow itself. The 2023 version handled sources statically. I
          started over from scratch and rebuilt it as a dynamic solution,
          paired with agentic Claude Code and a proposer agent workflow. Data
          contracts carry the governance up front, and the same contracts
          drive deterministic generation of the models. Predictable and
          inspectable.
        </p>

        <h3>Trust first</h3>
        <p>
          If data cannot be trusted, it does not get adopted. Even correct
          data sits unused when nobody can verify it. Software and workflows
          that nobody adopts do nothing. Trust is the prerequisite.
        </p>

        <h3>What MetricMine is</h3>
        <p>
          MetricMine is a downloadable pipeline anyone can run. It is my 18
          years of hard-earned pattern recognition, extracted, and the thing I
          wish I had at the start. It would have saved me months. Probably
          years.
        </p>
        <p>
          Industry standard tools sit at every gate. Airbyte at the door, with
          its catalog of <a href={AIRBYTE_CONNECTORS_URL}>600+ connectors</a>{' '}
          (Airbyte's own count) for your own sources. dbt for transformation.
          DuckDB for local storage. The contracts and the compiled context are
          warehouse-agnostic files in git, and dbt profiles carry the
          execution plane. The goal is a short path from a new source to a
          governed model that agents and downstream applications can use.
        </p>

        <h3>Thanks</h3>
        <p>
          Thank you to my wife and kids for their patience through the late
          nights and weekends. Thank you to God for the wisdom and energy to
          keep at this through long work hours and family demands, off and on
          from 2023 through 2026 and beyond.
        </p>
        <p class="signoff">{BUILDER_NAME}</p>
        <p class="verse">
          <q>Commit your work to the <span class="lord">LORD</span>, and your plans will be established.</q>
          <a class="ref" href={PROVERBS_16_3_URL}>Proverbs 16:3 ESV</a>
        </p>
      </div>
    </div>
  </section>

  <style>
    .band {
      background: var(--mm-bg-raised);
      border-block: 1px solid var(--mm-border);
    }

    .mark-row {
      display: grid;
      grid-template-columns: 72px minmax(0, 1fr);
      gap: 18px;
      align-items: start;
      margin-bottom: 8px;
    }

    .mark-row img {
      width: 72px;
      height: 72px;
    }

    .mark-row p {
      margin: 0;
    }

    .symbol-dark {
      display: none;
    }

    :global([data-theme='dark']) .symbol-dark {
      display: block;
    }

    :global([data-theme='dark']) .symbol-light {
      display: none;
    }

    /* The builder's section: the portrait beside the opener, the reading
       column, the sign-off in the heading face, and the closing verse in
       the brand emphasis color. Nothing italic: the self-hosted faces carry
       no italic axis (W-12), so a slanted style would be synthesized. */
    .testimony .byline {
      display: grid;
      grid-template-columns: 96px minmax(0, 1fr);
      gap: 20px;
      align-items: center;
      margin-bottom: 8px;
    }

    .testimony .byline h2 {
      margin: 0;
    }

    .testimony .portrait {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      object-fit: cover;
      border: 1px solid var(--mm-border);
    }

    .testimony .signoff {
      font-family: var(--font-manrope);
      font-weight: 700;
      margin: 20px 0 0;
    }

    .testimony .verse {
      margin: 24px 0 0;
      padding-top: 18px;
      border-top: 1px solid var(--mm-border);
      line-height: 1.6;
    }

    .testimony .verse q {
      font-family: var(--font-manrope);
      font-weight: 600;
      font-size: 1.0625rem;
      color: var(--mm-emph);
    }

    /* LORD as the ESV sets it: capitals one step smaller, lightly
       tracked. Set by hand because the faces carry no small-caps feature. */
    .testimony .verse .lord {
      font-size: 0.82em;
      letter-spacing: 0.06em;
    }

    .testimony .verse .ref {
      display: inline-block;
      margin-left: 10px;
      font-size: 0.875rem;
      white-space: nowrap;
    }
  </style>
</Base>
