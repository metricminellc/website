---
// The cube bullet, spec 7.4.2: the mark reduced to a three-face isometric
// glyph (mint top, green left, slate right). Decorative; hidden from
// assistive tech.
interface Props {
  size?: number;
  class?: string;
}
const { size = 20, class: className = 'cube' } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 18 18"
  aria-hidden="true"
>
  <polygon points="9,1 16,5 9,9 2,5" fill="#B4DACC"></polygon>
  <polygon points="2,5 9,9 9,17 2,13" fill="#5CAC94"></polygon>
  <polygon points="16,5 16,13 9,17 9,9" fill="#25444C"></polygon>
</svg>
