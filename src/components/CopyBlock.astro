---
// A command block with a copy button. The text is passed in, never
// invented here: every block on the site quotes the repository's own
// documentation (README, docs/demo.md).
interface Props {
  text: string;
  id: string;
  wrap?: boolean;
}
const { text, id, wrap = false } = Astro.props;
---

<div class="cmd">
  <pre class:list={[{ wrap }]}><code>{text}</code></pre>
  <button class="copy-btn" type="button" data-copy={id}>Copy</button>
  <script type="application/json" data-copy-text={id} set:html={JSON.stringify(text)} />
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((btn) => {
    const id = btn.dataset.copy;
    const src = document.querySelector<HTMLScriptElement>(
      `script[data-copy-text="${id}"]`,
    );
    if (!src) return;
    const text = JSON.parse(src.textContent || '""');
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = 'Copied';
        setTimeout(() => (btn.textContent = 'Copy'), 1600);
      } catch (e) {
        btn.textContent = 'Select and copy';
      }
    });
  });
</script>
