---
// The inner-page opener: eyebrow, title, lede, on the hero wash.
interface Props {
  eyebrow: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lede"><slot /></p>
  </div>
</section>
